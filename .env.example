# Copy to .env and fill in. Never commit .env.
SOURCES_CONFIG=/data/sources.toml
PROFILE_PATH=/data/profile.md
DB_PATH=/data/jobs.db

# Rating backend: claude (default) or systemone (Jev or Laya)
RATING_BACKEND=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_TIMEOUT_SECONDS=60

# Only for RATING_BACKEND=systemone
JEV_API_URL=https://jevmodel.org/v1/systemone
JEV_API_KEY=
JEV_MODEL=jev-latest

TZ=Europe/Zurich
PORT=8080
